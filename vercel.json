      "destination": "https://polytrack-hub-api.sawyerbobk563.workers.dev/api/messages"
    },
    {
      "source": "/api/hub/views",
      "destination": "https://polytrack-hub-api.sawyerbobk563.workers.dev/api/views"
    },
    {
