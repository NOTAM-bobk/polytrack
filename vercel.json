      "destination": "https://polytrack-hub-api.sawyerbobk563.workers.dev/api/views"
    },
    {
      "source": "/api/hub/bugs",
      "destination": "https://polytrack-hub-api.sawyerbobk563.workers.dev/api/bugs"
    },
    {
      "source": "/api/hub/bugs/",
